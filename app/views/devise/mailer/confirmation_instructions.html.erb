<p>¡Hola, <%= @resource.name %>!</p>

<% account_user = @resource&.account_users&.first %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <p><%= account_user.inviter.name %>, en conjunto con <%= account_user.account.name %>, te ha invitado a formar parte de <%= global_config['BRAND_NAME'] || 'Dodo' %>.</p>
<% end %>

<% if @resource.confirmed? %>
  <p>Ya puedes acceder a tu cuenta de <%= global_config['BRAND_NAME'] || 'Dodo' %> a través del siguiente enlace:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>
    ¡Bienvenido a <%= global_config['BRAND_NAME'] || 'Dodo' %>! Tenemos preparadas una serie de herramientas potentes para ayudarte. Antes de comenzar, necesitamos verificar tu dirección de correo electrónico para asegurar la seguridad de tu cuenta.
  </p>
  <% end %>
  <p>Por favor, haz clic en el botón de abajo para activar tu cuenta ahora mismo.</p>
<% end %>


<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Confirmar mi cuenta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <p><%= link_to 'Iniciar sesión', frontend_url('auth/sign_in') %></p>
<% elsif account_user&.inviter.present? %>
  <p><%= link_to 'Activar mi cuenta', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
<% else %>
  <p><%= link_to 'Confirmar mi cuenta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
